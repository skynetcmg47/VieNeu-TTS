VIENEU_MODEL_REPO=pnnbao-ump/VieNeu-TTS-v3-Turbo
VIENEU_MODEL_SUBFOLDER=update
VIENEU_CODEC_REPO=OpenMOSS-Team/MOSS-Audio-Tokenizer-Nano
VIENEU_VOICE=
VIENEU_DTYPE=auto
VIENEU_BACKEND=pytorch
VIENEU_DEVICE=cuda
VIENEU_WATERMARK=0
VIENEU_MAX_STREAMS=4
VIENEU_QUEUE=4
VIENEU_QUEUE_TIMEOUT=10
BENCHMARK_RUNS=3
BENCHMARK_CONCURRENCY=4
STARTUP_TIMEOUT=1800
REQUEST_TIMEOUT=300
CUDA_VISIBLE_DEVICES=0
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
HF_HOME=/cache/huggingface
LOG_DIR=/var/log/vieneu
WORKER_PORT=3000
WORKER_HTTP_PORT=3001
USE_SSL=true
UNSECURED=false
REPORT_ADDR=https://run.vast.ai
